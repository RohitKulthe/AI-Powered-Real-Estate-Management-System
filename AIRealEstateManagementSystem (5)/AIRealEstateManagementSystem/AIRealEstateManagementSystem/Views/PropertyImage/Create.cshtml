@model AIRealEstateManagementSystem.Models.PropertyImage

@{
    ViewData["Title"] = "Add Property Image";
    Layout = "_AdminLayout";
}

<h2>Add Property Image</h2>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <input asp-for="PropertyId" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label"></label>

        <input asp-for="ImageFile"
               type="file"
               class="form-control"
               accept="image/*" />

        <span asp-validation-for="ImageFile" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Upload Image
    </button>

    <a asp-controller="Property"
       asp-action="Details"
       asp-route-id="@Model.PropertyId"
       class="btn btn-secondary">
        Back
    </a>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}