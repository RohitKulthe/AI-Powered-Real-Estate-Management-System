@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <p>
        At <strong>AI Real Estate Management System</strong>, we value your privacy and are committed
        to protecting your personal information. This Privacy Policy explains how we collect, use,
        and safeguard the information you provide while using our website.
    </p>

    <h3>Information We Collect</h3>
    <ul>
        <li>Personal details such as your name, email address, and phone number.</li>
        <li>Property inquiry and booking information.</li>
        <li>Website usage data to improve user experience.</li>
    </ul>

    <h3>How We Use Your Information</h3>
    <ul>
        <li>To manage property inquiries and bookings.</li>
        <li>To provide AI-powered property recommendations.</li>
        <li>To communicate important updates and notifications.</li>
        <li>To improve our services and website performance.</li>
    </ul>

    <h3>Data Security</h3>
    <p>
        We implement appropriate security measures to protect your personal information from
        unauthorized access, disclosure, or misuse.
    </p>

    <h3>Contact Us</h3>
    <p>
        If you have any questions regarding this Privacy Policy, please contact us through the
        Contact page or email our support team.
    </p>
</div>