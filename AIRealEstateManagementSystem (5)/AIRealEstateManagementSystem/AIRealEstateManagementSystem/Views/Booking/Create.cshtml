@model AIRealEstateManagementSystem.Models.Booking

<h2>Book Property Visit</h2>

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="PropertyId" />

    <div class="mb-3">
        <label>Visit Date</label>
        <input asp-for="VisitDate" type="date" class="form-control" />
        <span asp-validation-for="VisitDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Visit Time</label>
        <input asp-for="VisitTime" type="time" class="form-control" />
        <span asp-validation-for="VisitTime" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Book Visit
    </button>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}