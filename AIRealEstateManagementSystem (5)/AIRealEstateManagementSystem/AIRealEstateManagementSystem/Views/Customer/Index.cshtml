@{
    ViewData["Title"] = "Customer Portal";
}

<div class="container mt-5">

    <div class="text-center">

        <h1 class="display-4 fw-bold text-primary">
            Welcome to AI Real Estate
        </h1>

        <p class="lead">
            Find your dream property with AI-powered recommendations.
        </p>

    </div>

    <div class="row mt-5">

        <div class="col-md-4 mb-4">

            <div class="card shadow">

                <img src="~/images/property-placeholder.jpg"
                     class="card-img-top"
                     style="height:220px;object-fit:cover;" />

                <div class="card-body">

                    <h4>Luxury Villa</h4>

                    <p>

                        Pune, Maharashtra

                    </p>

                    <h5 class="text-success">

                        ₹1.20 Cr

                    </h5>

                    <a href="#"
                       class="btn btn-primary w-100">

                        View Details

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="card shadow">

                <img src="~/images/property-placeholder.jpg"
                     class="card-img-top"
                     style="height:220px;object-fit:cover;" />

                <div class="card-body">

                    <h4>Modern Apartment</h4>

                    <p>

                        Mumbai, Maharashtra

                    </p>

                    <h5 class="text-success">

                        ₹85 Lakh

                    </h5>

                    <a href="#"
                       class="btn btn-primary w-100">

                        View Details

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="card shadow">

                <img src="~/images/property-placeholder.jpg"
                     class="card-img-top"
                     style="height:220px;object-fit:cover;" />

                <div class="card-body">

                    <h4>Premium Bungalow</h4>

                    <p>

                        Nashik, Maharashtra

                    </p>

                    <h5 class="text-success">

                        ₹2.30 Cr

                    </h5>

                    <a href="#"
                       class="btn btn-primary w-100">

                        View Details

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>