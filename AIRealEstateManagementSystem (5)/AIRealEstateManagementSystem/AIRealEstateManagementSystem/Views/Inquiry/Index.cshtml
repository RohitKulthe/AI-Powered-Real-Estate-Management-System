@model IEnumerable<AIRealEstateManagementSystem.Models.Inquiry>

@{
    ViewData["Title"] = "All Inquiries";
}

<div class="container mt-4">

    <h2 class="mb-4">All Inquiries</h2>

    <table class="table table-bordered table-hover table-striped align-middle">

        <thead class="table-dark">
            <tr>
                <th>Inquiry Id</th>
                <th>Property</th>
                <th>Customer</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Message</th>
                <th>Date</th>
                <th>Status</th>
                <th width="170">Action</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.InquiryId</td>

                    <td>
                        @(item.Property?.PropertyName ?? "N/A")
                    </td>

                    <td>@item.Name</td>

                    <td>@item.Email</td>

                    <td>@item.Phone</td>

                    <td>@item.Message</td>

                    <td>@item.InquiryDate.ToString("dd-MM-yyyy")</td>

                    <td>
                        @if (item.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (item.Status == "Contacted")
                        {
                            <span class="badge bg-primary">
                                Contacted
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Closed
                            </span>
                        }
                    </td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@item.InquiryId"
                           class="btn btn-sm btn-primary">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.InquiryId"
                           class="btn btn-sm btn-danger"
                           onclick="return confirm('Are you sure you want to delete this inquiry?');">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>