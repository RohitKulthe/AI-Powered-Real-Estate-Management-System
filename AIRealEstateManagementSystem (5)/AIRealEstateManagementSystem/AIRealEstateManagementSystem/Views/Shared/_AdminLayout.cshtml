<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-custom.css" asp-append-version="true" />
</head>

<body>

    <div class="d-flex">

        <!-- Sidebar -->
        <div class="bg-dark text-white p-3"
             style="width:260px;height:100vh;position:fixed;overflow-y:auto;">

            <h2 class="text-center fw-bold mb-4">
                AI Real Estate
            </h2>

            <hr />

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-dark w-100 text-start mb-2">
                <i class="bi bi-house-door me-2"></i>
                Home
            </a>

            <a asp-controller="Property"
               asp-action="Index"
               class="btn btn-dark w-100 text-start mb-2">
                <i class="bi bi-house me-2"></i>
                Properties
            </a>

            <a asp-controller="Booking"
               asp-action="Index"
               class="btn btn-dark w-100 text-start mb-2">
                <i class="bi bi-calendar-check me-2"></i>
                Bookings
            </a>

            <a asp-controller="Review"
               asp-action="Index"
               class="btn btn-dark w-100 text-start mb-2">
                <i class="bi bi-star me-2"></i>
                Reviews
            </a>

            <a asp-controller="Inquiry"
               asp-action="Index"
               class="btn btn-dark w-100 text-start mb-2">
                <i class="bi bi-chat-dots me-2"></i>
                Inquiry
            </a>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-dark w-100 text-start mb-2">
                <i class="bi bi-robot me-2"></i>
                AI Analytics
            </a>

            <hr />

            <a asp-controller="Account"
               asp-action="Logout"
               class="btn btn-danger w-100">
                <i class="bi bi-box-arrow-right me-2"></i>
                Logout
            </a>

        </div>

        <!-- Main Content -->
        <main style="margin-left:260px;width:100%;padding:30px;">

            @RenderBody()

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>