@model AIRealEstateManagementSystem.Models.Property

@{
    ViewData["Title"] = "Delete Property";
    Layout = "_AdminLayout";
}

<h2 class="text-danger">Delete Property</h2>

<h4>Are you sure you want to delete this property?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">Property Name</dt>
    <dd class="col-sm-9">@Model.PropertyName</dd>

    <dt class="col-sm-3">City</dt>
    <dd class="col-sm-9">@Model.City</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.Price</dd>

</dl>

<form asp-action="Delete" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="PropertyId" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>